# ==============================================================================
# Mathsy Meet External Customer Integration Demo — Environment Configuration
# ==============================================================================
# NOTE: Replace placeholder values with your organization's server credentials.
# NEVER commit raw API keys or expose them in client-side bundles or public repositories.
# ==============================================================================

# Port on which the customer backend runs
PORT=5002

# Mathsy Meet SaaS API Base URL (Control Plane)
# In local development: http://localhost:5001/api/v1
# In production: https://api.mathsy.in/api/v1
MATHSY_MEET_API_URL=http://localhost:5001/api/v1

# Mathsy Meet Hosted Embed Base URL
# In local development: http://localhost:5174 (Vite dev server) or http://localhost:5001
# In production: https://meet.mathsy.in
MATHSY_MEET_EMBED_URL=http://localhost:5174

# Customer Secret API Key (Server-Only credential from Mathsy Meet Dashboard)
# Generate from Mathsy Meet Developer Console with scopes: rooms:read, rooms:write, tokens:write
MATHSY_MEET_API_KEY=sec_test_your_secret_api_key_here
