# ==============================================================================
# Mathsy Meet Control-Plane — Environment Variables Template
# ==============================================================================
# Copy this file to .env or .env.local for local development.
# NEVER commit real credentials, production secrets, or private keys to git.
# In production (NODE_ENV=production), weak or default values will cause startup failure.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Environment & Network
# ------------------------------------------------------------------------------
NODE_ENV="development"
PORT=5001
VITE_APP_NAME="Mathsy Meet"
FRONTEND_URL="http://localhost:5174"
VITE_API_BASE_URL="http://localhost:5001/api"

# Comma-separated list of allowed CORS web origins for browser credentials & embed access.
# Example for staging/production: "https://staging.mathsy.in,https://app.mathsy.in"
CORS_ALLOWED_ORIGINS="http://localhost:5174,http://127.0.0.1:5174"

# ------------------------------------------------------------------------------
# 2. Cryptographic Secrets (Backend Only — Never expose to browser)
# ------------------------------------------------------------------------------
# Primary application session & user JWT signing secret.
# In production: Required, minimum 32 characters of high-entropy randomness.
# Generate with: openssl rand -hex 32
JWT_SECRET="replace_with_min_32_character_cryptographic_jwt_secret"

# CRITICAL SFU ALIGNMENT SECRET:
# Participant token signing secret used to mint short-lived tokens for mediasoup SFU.
# - MUST be explicitly configured in staging and production.
# - MUST match EXACTLY the PARTICIPANT_JWT_SECRET configured on the SFU (mathsy-meet-server).
# - In development only, if unset, code falls back to JWT_SECRET for convenience.
#   RISK: In development, fallback tokens will be rejected by SFU if SFU has a different key.
# - In production: Fallback is strictly disabled. Minimum 32 characters required.
# Generate with: openssl rand -hex 32
PARTICIPANT_JWT_SECRET="replace_with_min_32_character_sfu_matching_secret"

# Webhook Secret Encryption Key (AES-256-GCM):
# Used to encrypt customer webhook signing secrets at rest in PostgreSQL.
# Must be exactly 32 bytes (64 hex characters or 32 raw bytes).
# Generate with: openssl rand -hex 32
WEBHOOK_ENCRYPTION_KEY="replace_with_64_hex_character_key_0123456789abcdef0123456789abcdef"

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Primary relational database URL (users, rooms, organizations, API keys, usage).
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/mathsy_meet"

# Set to true only in development/testing if connecting to localhost with NODE_ENV=production
ALLOW_LOCAL_DATABASE="false"

# ------------------------------------------------------------------------------
# 4. MongoDB In-Session Temporary Chat Storage (Backend Only)
# ------------------------------------------------------------------------------
# Required in production for in-class temporary chat persistence and session locking.
# In development, defaults to mongodb://localhost:27017 if unset.
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="mathsy_meet_chat"

# Set to true only if intentionally running the server without in-class chat persistence
DISABLE_MONGODB="false"

# ------------------------------------------------------------------------------
# 5. SFU & External Services
# ------------------------------------------------------------------------------
# SFU server URL for client WebRTC signaling (baked into frontend bundle at build time)
VITE_MEDIASOUP_SERVER_URL="https://rtc.mathsy.in"

# Optional SFU health check URL for backend system monitoring probes (/api/health)
SFU_HEALTH_URL="https://rtc.mathsy.in"

# ------------------------------------------------------------------------------
# 6. Third-Party Integrations
# ------------------------------------------------------------------------------
# Supabase Auth & Storage (client-facing)
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Google OAuth Client ID for Tutor/Student Login
VITE_GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"

# Tldraw License Key for Whiteboard
VITE_TLDRAW_LICENSE_KEY="your_tldraw_license_key"
